# Liste de paramètres à injecter dans le processus Spring Boot.
# Ce fichier n'est pas chargé automatiquement. Aucune clé dans React/Flutter.
APP_NOTIFICATION_GATEWAY_URL=
APP_NOTIFICATION_GATEWAY_SECRET=
APP_NOTIFICATION_TENTATIVES_MAX=5
APP_NOTIFICATION_DELAI_REPRISE_SECONDES=30
APP_LIVEKIT_URL=
APP_LIVEKIT_API_KEY=
APP_LIVEKIT_API_SECRET=
# N'activer qu'après validation de la révocation sur l'infrastructure retenue.
APP_LIVEKIT_REVOCATION_ACTIVE=false
